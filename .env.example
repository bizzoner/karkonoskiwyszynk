INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=

# Zmienne środowiskowe - ustawiane w panelu Netlify (Site configuration → Environment variables).
# Lokalnie: skopiuj do .env (plik jest w .gitignore). Bez RESEND_API_KEY lokalny serwer
# nie wysyła maili, tylko zapisuje je do podglądu: http://localhost:8955/dev/maile

# Klucz API z resend.com (uprawnienie: Sending access, tylko domena karkonoskiwyszynk.pl)
RESEND_API_KEY=
# Nadawca - domena musi być zweryfikowana w Resend (SPF + DKIM)
MAIL_FROM="Karkonoski Wyszynk <rezerwacje@mail.karkonoskiwyszynk.pl>"
# Skrzynka restauracji: nowe rezerwacje i zamówienia cateringu
MAIL_RESTAURACJA=anastasia.vilk@relaxtour.pl
# Hasło do /panel/ (wspólne dla pracowników) - min. 12 znaków
PANEL_HASLO=
# Losowy sekret do podpisywania linków w mailach i sesji panelu - min. 32 znaki
# (np. wynik: openssl rand -hex 32). Zmiana unieważnia stare linki z maili.
PANEL_SEKRET=
