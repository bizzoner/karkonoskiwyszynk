/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/opinia/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/panel/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# Zdjęcia: nazwy plików nie mają hasha, więc tydzień cache + odświeżanie w tle.
# Podmieniając zdjęcie pod tą samą nazwą, licz się z tygodniem starej wersji u gości.
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Dane publiczne dla wyszukiwarek i asystentów AI (tylko odczyt)
/menu.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/openapi.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
